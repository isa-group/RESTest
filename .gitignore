# ---------------------------------------------------------------------------
# RESTest 2.0 run output
# ---------------------------------------------------------------------------
# restest-report/ is a Maven module — do NOT ignore the module directory.
# The CLI writes its HTML output to restest-out/ at runtime.
restest-out/
*.log
/tmp/

# ---------------------------------------------------------------------------
# Evaluation harness
# Scoreboards are committed; raw run output is not.
# ---------------------------------------------------------------------------
evaluation/results/raw/
evaluation/.scratch/

# ---------------------------------------------------------------------------
# Credentials and local overrides
# ---------------------------------------------------------------------------
src/test/resources/auth/*
!src/test/resources/auth/Sample/
src/test/resources/auth/Sample/apikeys.json
src/test/resources/auth/Sample/headers.json
src/test/resources/auth/Sample/oauth.json
src/test/resources/auth/Sample/oauth_wrong.json
src/test/resources/auth/Sample/oauth_short_expiration.json
.claude/settings.local.json

