<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.restest</groupId>
        <artifactId>restest</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>restest-gen</artifactId>
    <name>RESTest :: Gen</name>
    <description>Generation phases, value providers, and scheduler.</description>

    <dependencies>
        <dependency>
            <groupId>io.restest</groupId>
            <artifactId>restest-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.restest</groupId>
            <artifactId>restest-idl</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            Reads the lists of values a run is given. YAML rather than JSON because those files are
            the part of this tool somebody is most likely to write by hand, and because the
            specifications they sit beside are written in it too. A YAML reader also reads JSON,
            which is a subset of it, so a file written either way is read either way.

            Pinned in the parent, where it already was: it arrives through swagger-parser as well,
            and the two have to move together.
        -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <!--
          Test scope only, and deliberately so. Nothing this module publishes depends on the parser -
          the architecture rules read production bytecode and would fail if it did. But the question
          "does generation work against real specifications?" can only be answered by reading real
          specifications, and reading them is the parser's job. The alternative, hand-written models,
          would test the generator against shapes chosen by the same person who wrote the generator,
          which is exactly the test that never fails when it should.

          The corpus documents themselves are read out of the checkout rather than from a test-jar
          published by restest-spec, deliberately: several of them carry no licence at all, and the
          corpus README is explicit that they are used as internal test fixtures and never
          redistributed. Publishing them inside an artifact would be redistributing them.

          The exception is recorded in SourceTreeRulesTest, which fails if any other module takes
          the same dependency without being named there.
        -->
        <dependency>
            <groupId>io.restest</groupId>
            <artifactId>restest-spec</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
