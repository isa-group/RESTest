<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.restest</groupId>
        <artifactId>restest</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>restest-gen</artifactId>
    <name>RESTest :: Gen</name>
    <description>Generation phases, value providers, and scheduler.</description>

    <dependencies>
        <dependency>
            <groupId>io.restest</groupId>
            <artifactId>restest-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.restest</groupId>
            <artifactId>restest-idl</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            Builds a string that matches a regular expression. A specification states the characters
            it will accept as a `pattern`, and working backwards from one to a string that satisfies
            it is a small compiler - a parser for a dialect that is not quite Java's, and a walk over
            the result - which is exactly the kind of thing worth taking off the shelf rather than
            writing here. Apache-2.0, no dependencies of its own.

            It takes a java.util.random.RandomGenerator, which is the same seeded source the rest of
            generation draws on, so nothing about repeating a run exactly had to change to use it.

            The jar carries no module descriptor and no Automatic-Module-Name, so `requires rgxgen`
            names an automatic module derived from the file name. The cost, and why it is accepted,
            is in ADR-0022.

            Confined to this module by an architecture rule, like every other library here.
        -->
        <dependency>
            <groupId>com.github.curious-odd-man</groupId>
            <artifactId>rgxgen</artifactId>
        </dependency>

        <!--
          Test scope only, and deliberately so. Nothing this module publishes depends on the parser -
          the architecture rules read production bytecode and would fail if it did. But the question
          "does generation work against real specifications?" can only be answered by reading real
          specifications, and reading them is the parser's job. The alternative, hand-written models,
          would test the generator against shapes chosen by the same person who wrote the generator,
          which is exactly the test that never fails when it should.

          The corpus documents themselves are read out of the checkout rather than from a test-jar
          published by restest-spec, deliberately: several of them carry no licence at all, and the
          corpus README is explicit that they are used as internal test fixtures and never
          redistributed. Publishing them inside an artifact would be redistributing them.

          The exception is recorded in SourceTreeRulesTest, which fails if any other module takes
          the same dependency without being named there.
        -->
        <dependency>
            <groupId>io.restest</groupId>
            <artifactId>restest-spec</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
