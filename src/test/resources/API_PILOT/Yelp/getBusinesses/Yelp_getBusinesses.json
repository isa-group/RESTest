{
    "openapi": "3.0.0",
    "info": {
        "description": "Yelp getBusinesses API",
        "version": "1.0.0",
        "title": "Yelp getBusinesses API"
    },
    "paths": {
        "/businesses/search": {
            "get": {
                "operationId": "getBusinesses",
                "summary": "Get businesses",
                "description": "Get businesses",
                "parameters": [
                    {
                        "name": "term",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "location",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "latitude",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "longitude",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "radius",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 40000
                        }
                    },
                    {
                        "name": "categories",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    {
                        "name": "locale",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 50
                        }
                    },
                    {
                        "name": "offset",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "sort_by",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "best_match",
                                "rating",
                                "review_count",
                                "distance"
                            ]
                        }
                    },
                    {
                        "name": "price",
                        "in": "query",
                        "required": false,
                        "style": "form",
                        "explode": false,
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "enum": [
                                    1,
                                    2,
                                    3,
                                    4
                                ]
                            }
                        }
                    },
                    {
                        "name": "open_now",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "open_at",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "device_platform",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "android",
                                "ios",
                                "mobile-generic"
                            ]
                        }
                    },
                    {
                        "name": "attributes",
                        "in": "query",
                        "required": false,
                        "style": "form",
                        "explode": false,
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "enum": [
                                    "hot_and_new",
                                    "request_a_quote",
                                    "reservation",
                                    "waitlist_reservation",
                                    "deals",
                                    "gender_neutral_restrooms",
                                    "open_to_all",
                                    "wheelchair_accessible"
                                ]
                            }
                        }
                    }
                ],
                "x-dependencies": [
                    "Or(location, latitude AND longitude);",
                    "ZeroOrOne(open_now, open_at);",
                    "offset + limit <= 1000;",
                    "IF offset AND NOT limit THEN offset <= 980;"
                ],
                "responses": {
                    "200": {
                        "description": "Returns all businesses",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BusinessesResult"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "servers": [
        {
            "url": "https://api.yelp.com/v3"
        }
    ],
    "components": {
        "schemas": {
            "BusinessesResult": {
                "type": "object",
                "properties": {
                    "total": {
                        "type": "integer"
                    },
                    "region": {
                        "type": "object",
                        "properties": {
                            "center": {
                                "type": "object",
                                "properties": {
                                    "latitude": {
                                        "type": "number",
                                        "nullable": true
                                    },
                                    "longitude": {
                                        "type": "number"
                                    }
                                }
                            }
                        }
                    },
                    "businesses": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "categories": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "alias": {
                                                "type": "string"
                                            },
                                            "title": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                },
                                "coordinates": {
                                    "type": "object",
                                    "properties": {
                                        "latitude": {
                                            "type": "number"
                                        },
                                        "longitude": {
                                            "type": "number"
                                        }
                                    }
                                },
                                "display_phone": {
                                    "type": "string"
                                },
                                "distance": {
                                    "type": "number"
                                },
                                "id": {
                                    "type": "string"
                                },
                                "alias": {
                                    "type": "string"
                                },
                                "image_url": {
                                    "type": "string"
                                },
                                "is_closed": {
                                    "type": "boolean"
                                },
                                "name": {
                                    "type": "string"
                                },
                                "phone": {
                                    "type": "string"
                                },
                                "price": {
                                    "type": "string",
                                    "enum": [
                                        "$",
                                        "$$",
                                        "$$$",
                                        "$$$$",
                                        "£",
                                        "££",
                                        "£££",
                                        "££££",
                                        "€",
                                        "€€",
                                        "€€€",
                                        "€€€€",
                                        "￥",
                                        "￥￥",
                                        "￥￥￥",
                                        "￥￥￥￥"
                                    ]
                                },
                                "rating": {
                                    "type": "number",
                                    "minimum": 1,
                                    "maximum": 5
                                },
                                "review_count": {
                                    "type": "integer"
                                },
                                "url": {
                                    "type": "string"
                                },
                                "transactions": {
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "enum": [
                                            "pickup",
                                            "delivery",
                                            "restaurant_reservation"
                                        ]
                                    }
                                },
                                "location": {
                                    "type": "object",
                                    "properties": {
                                        "address1": {
                                            "type": "string",
                                            "nullable": true
                                        },
                                        "address2": {
                                            "type": "string",
                                            "nullable": true
                                        },
                                        "address3": {
                                            "type": "string",
                                            "nullable": true
                                        },
                                        "city": {
                                            "type": "string"
                                        },
                                        "country": {
                                            "type": "string"
                                        },
                                        "display_address": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "state": {
                                            "type": "string"
                                        },
                                        "zip_code": {
                                            "type": "string",
                                            "nullable": true
                                        }
                                    }
                                },
                                "attributes": {
                                    "type": "object",
                                    "description": "Special features and amenities offered by the business.",
                                    "properties": {
                                        "business_accepts_credit_cards": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business accepts credit card payments."
                                        },
                                        "bike_parking": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business has bike parking available."
                                        },
                                        "wheelchair_accessible": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business is accessible by wheelchair."
                                        },
                                        "dogs_allowed": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether dogs are allowed on the premises."
                                        },
                                        "hot_and_new": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business is new and trending."
                                        },
                                        "liked_by_vegetarians": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business is popular among vegetarians."
                                        },
                                        "gender_neutral_restrooms": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business has gender-neutral restrooms."
                                        },
                                        "open_to_all": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business is explicitly inclusive and open to all communities."
                                        },
                                        "restaurants_counter_service": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the restaurant offers counter service."
                                        },
                                        "restaurants_good_for_groups": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the restaurant is suitable for group dining."
                                        },
                                        "request_a_quote": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business accepts quote requests."
                                        },
                                        "reservation": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business accepts reservations."
                                        },
                                        "waitlist_reservation": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business supports joining a waitlist remotely."
                                        }
                                    }
                                },
                                "business_hours": {
                                    "type": "array",
                                    "description": "Opening hours for the business, grouped by hours type (e.g. REGULAR).",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "hours_type": {
                                                "type": "string",
                                                "description": "The type of hours, e.g. REGULAR."
                                            },
                                            "open": {
                                                "type": "array",
                                                "description": "List of time windows the business is open during the week.",
                                                "items": {
                                                    "type": "object",
                                                    "properties": {
                                                        "day": {
                                                            "type": "integer",
                                                            "description": "Day of the week: 0 = Monday, 6 = Sunday."
                                                        },
                                                        "start": {
                                                            "type": "string",
                                                            "description": "Opening time in 24-hour format (e.g. 0900)."
                                                        },
                                                        "end": {
                                                            "type": "string",
                                                            "description": "Closing time in 24-hour format (e.g. 2100)."
                                                        },
                                                        "is_overnight": {
                                                            "type": "boolean",
                                                            "description": "Whether the hours span midnight into the next day."
                                                        }
                                                    }
                                                }
                                            },
                                            "is_open_now": {
                                                "type": "boolean",
                                                "description": "Whether the business is currently open."
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}