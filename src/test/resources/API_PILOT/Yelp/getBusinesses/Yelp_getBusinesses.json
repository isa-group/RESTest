{
    "openapi": "3.0.0",
    "info": {
        "description": "Yelp getBusinesses API",
        "version": "1.0.0",
        "title": "Yelp getBusinesses API"
    },
    "paths": {
        "/businesses/search": {
            "get": {
                "operationId": "getBusinesses",
                "summary": "Get businesses",
                "description": "Get businesses",
                "parameters": [
                    {
                        "name": "term",
                        "in": "query",
                        "required": false,
                        "description": "Search term, e.g. \"food\" or \"restaurants\".\nThe term may also be the business's name, such as \"Starbucks\". If term is not included the endpoint will default to searching across businesses from a small number of popular categories.\n",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "location",
                        "in": "query",
                        "required": false,
                        "description": "Required if either *latitude* or *longitude* is not provided.\nThis string indicates the geographic area to be used when searching for businesses.\nExamples: \"New York City\", \"NYC\", \"350 5th Ave, New York, NY 10118\".\nBusinesses returned in the response may not be strictly within the specified location.\n",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "latitude",
                        "in": "query",
                        "required": false,
                        "description": "Required, if _location_ is not provided. Latitude of the location to search from. If latitude is provided, longitude is required too.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "longitude",
                        "in": "query",
                        "required": false,
                        "description": "Required if _location_ is not provided. Longitude of the location to search from. If longitude is provided, latitude is required too.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "radius",
                        "in": "query",
                        "required": false,
                        "description": "A suggested search radius in meters. This field is used as a suggestion to the search. The actual search radius may be lower than the suggested radius in dense urban areas, and higher in regions of less business density.\nIf the specified value is too large, a AREA_TOO_LARGE error may be returned. The max value is 40,000 meters (about 25 miles).\n",
                        "schema": {
                            "type": "integer",
                            "maximum": 40000
                        }
                    },
                    {
                        "name": "categories",
                        "in": "query",
                        "required": false,
                        "description": "Categories to filter the search results with. See the list of supported categories. The category filter can be a list of comma delimited categories.\ne.g., \"bars,french\" will filter by Bars OR French.\nThe category alias should be used (e.g. \"discgolf\", not \"Disc Golf\").\n",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    {
                        "name": "locale",
                        "in": "query",
                        "required": false,
                        "description": "Locale code in the format of {language code}_{country code}. See the list of supported locales.\n",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "description": "Number of results to return.",
                        "schema": {
                            "type": "integer",
                            "maximum": 50
                        }
                    },
                    {
                        "name": "offset",
                        "in": "query",
                        "required": false,
                        "description": "Offset the list of returned results by this amount.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "sort_by",
                        "in": "query",
                        "required": false,
                        "description": "Suggestion to the search algorithm that the results be sorted by one of the these modes: *best_match*, *rating*, *review_count* or *distance*.\nThe default is *best_match*. Note that specifying the sort_by is a suggestion (not strictly enforced) to Yelp's search, which considers multiple input parameters to return the most relevant results.\n\ne.g., the *rating* sort is not strictly sorted by the rating value, but by an adjusted rating value that takes into account the number of ratings,\nsimilar to a Bayesian average. This is to prevent skewing results to businesses with a single review.\n",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "best_match",
                                "rating",
                                "review_count",
                                "distance"
                            ]
                        }
                    },
                    {
                        "name": "price",
                        "in": "query",
                        "required": false,
                        "description": "Pricing levels to filter the search result with: 1 = $, 2 = $$, 3 = $$$, 4 = $$$$. The price filter can be a list of comma delimited pricing levels.\ne.g., \"1, 2, 3\" will filter the results to show the ones that are $, $$, or $$$.\n",
                        "style": "form",
                        "explode": false,
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "enum": [
                                    1,
                                    2,
                                    3,
                                    4
                                ]
                            }
                        }
                    },
                    {
                        "name": "open_now",
                        "in": "query",
                        "required": false,
                        "description": "When set to true, only return the businesses that are open now.\nNotice that _open_at_ and _open_now_ cannot be used together.\n",
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "open_at",
                        "in": "query",
                        "required": false,
                        "description": "An integer representing the Unix time in the timezone of the search location. If specified, it will return businesses open at the given time.\nNotice that *open_at* and *open_now* cannot be used together.\n",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "device_platform",
                        "in": "query",
                        "required": false,
                        "description": "Determines the platform for mobile_link",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "android",
                                "ios",
                                "mobile-generic"
                            ]
                        }
                    },
                    {
                        "name": "attributes",
                        "in": "query",
                        "required": false,
                        "description": "Try these additional filters to return specific search results!\n- *hot_and_new* - popular businesses which recently joined Yelp\n- *request_a_quote* - businesses which actively reply to Request a Quote inquiries\n- *reservation* - businesses with Yelp Reservations bookings enabled on their profile page\n- *waitlist_reservation* - businesses with Yelp _Wait List_ bookings enabled on their profile screen (iOS/Android)\n- *gender_neutral_restrooms* - businesses which provide gender neutral restrooms\n- *open_to_all* - businesses which are Open To All\n- *wheelchair_accessible* - businesses which are Wheelchair Accessible\n",
                        "style": "form",
                        "explode": false,
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "enum": [
                                    "hot_and_new",
                                    "request_a_quote",
                                    "reservation",
                                    "waitlist_reservation",
                                    "deals",
                                    "gender_neutral_restrooms",
                                    "open_to_all",
                                    "wheelchair_accessible"
                                ]
                            }
                        }
                    }
                ],
                "x-dependencies": [
                    "Or(location, latitude AND longitude);",
                    "ZeroOrOne(open_now, open_at);",
                    "offset + limit <= 1000;",
                    "IF offset AND NOT limit THEN offset <= 980;"
                ],
                "responses": {
                    "200": {
                        "description": "Returns all businesses",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BusinessesResult"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "servers": [
        {
            "url": "https://api.yelp.com/v3"
        }
    ],
    "components": {
        "schemas": {
            "BusinessesResult": {
                "type": "object",
                "properties": {
                    "total": {
                        "type": "integer",
                        "description": "Total number of businesses Yelp finds based on the search criteria. Sometimes, the value may exceed 240. In such case, you still can only get up to 240 businesses using multiple queries and combinations of the \"limit\" and \"offset\" parameters.\n"
                    },
                    "region": {
                        "type": "object",
                        "description": "Suggested area in a map to display results in.",
                        "properties": {
                            "center": {
                                "type": "object",
                                "description": "Center location of the region.",
                                "properties": {
                                    "latitude": {
                                        "type": "number",
                                        "nullable": true,
                                        "description": "Latitude of this business."
                                    },
                                    "longitude": {
                                        "type": "number",
                                        "description": "Longitude of this business."
                                    }
                                }
                            }
                        }
                    },
                    "businesses": {
                        "type": "array",
                        "description": "Array of businesses matching the search criteria.",
                        "items": {
                            "type": "object",
                            "description": "A Business Yelp finds based on the search criteria.",
                            "properties": {
                                "categories": {
                                    "type": "array",
                                    "description": "List of category title and alias pairs associated with this business.",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "alias": {
                                                "type": "string",
                                                "description": "Alias of a category, when searching for business in certain categories."
                                            },
                                            "title": {
                                                "type": "string",
                                                "description": "Title of a category for display purposes."
                                            }
                                        }
                                    }
                                },
                                "coordinates": {
                                    "type": "object",
                                    "description": "Latitude and longitude coordinates of this business.",
                                    "properties": {
                                        "latitude": {
                                            "type": "number",
                                            "description": "Latitude of this business."
                                        },
                                        "longitude": {
                                            "type": "number",
                                            "description": "Longitude of this business."
                                        }
                                    }
                                },
                                "display_phone": {
                                    "type": "string",
                                    "description": "Phone number of the business formatted nicely to be displayed to users. The format is the standard phone number format for the business's country."
                                },
                                "distance": {
                                    "type": "number",
                                    "description": "Distance in meters from the search location. This value is in meters(m) regardless of the locale."
                                },
                                "id": {
                                    "type": "string",
                                    "description": "Unique Yelp ID of this business."
                                },
                                "alias": {
                                    "type": "string",
                                    "description": "Unique Yelp alias of this business. Can contain unicode characters.\nExample: 'yelp-san-francisco'.\n"
                                },
                                "image_url": {
                                    "type": "string",
                                    "description": "URL of photo for this business"
                                },
                                "is_closed": {
                                    "type": "boolean",
                                    "description": "Whether business has been (permanently) closed"
                                },
                                "name": {
                                    "type": "string",
                                    "description": "Name of this business."
                                },
                                "phone": {
                                    "type": "string",
                                    "description": "Phone number of the business."
                                },
                                "price": {
                                    "type": "string",
                                    "description": "Price level of the business. Uses the currency symbol of the provided locale. Value for en_US is one of $, $$, $$$ or $$$$.",
                                    "enum": [
                                        "$",
                                        "$$",
                                        "$$$",
                                        "$$$$",
                                        "£",
                                        "££",
                                        "£££",
                                        "££££",
                                        "€",
                                        "€€",
                                        "€€€",
                                        "€€€€",
                                        "￥",
                                        "￥￥",
                                        "￥￥￥",
                                        "￥￥￥￥"
                                    ]
                                },
                                "rating": {
                                    "type": "number",
                                    "description": "Rating for this business (value ranges from 1, 1.5, ... 4.5, 5).",
                                    "minimum": 1,
                                    "maximum": 5
                                },
                                "review_count": {
                                    "type": "integer",
                                    "description": "Number of reviews for this business."
                                },
                                "url": {
                                    "type": "string",
                                    "description": "URL for business page on Yelp."
                                },
                                "transactions": {
                                    "type": "array",
                                    "description": "List of Yelp transactions that the business is registered for. Current supported values are pickup, delivery and restaurant_reservation.",
                                    "items": {
                                        "type": "string",
                                        "enum": [
                                            "pickup",
                                            "delivery",
                                            "restaurant_reservation"
                                        ]
                                    }
                                },
                                "location": {
                                    "type": "object",
                                    "description": "Location of this business, including address, city, state, zip code and country.",
                                    "properties": {
                                        "address1": {
                                            "type": "string",
                                            "nullable": true,
                                            "description": "Street address of this business."
                                        },
                                        "address2": {
                                            "type": "string",
                                            "nullable": true,
                                            "description": "Street address of this business, continued."
                                        },
                                        "address3": {
                                            "type": "string",
                                            "nullable": true,
                                            "description": "Street address of this business, continued (usually secondary unit or floor number)."
                                        },
                                        "city": {
                                            "type": "string",
                                            "description": "City of this business."
                                        },
                                        "country": {
                                            "type": "string",
                                            "description": "ISO 3166-1 alpha-2 country code of this business."
                                        },
                                        "display_address": {
                                            "type": "array",
                                            "description": "Array of strings that if joined with a newline, addresses the business.",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "state": {
                                            "type": "string",
                                            "description": "ISO 3166-2 state code of this business."
                                        },
                                        "zip_code": {
                                            "type": "string",
                                            "nullable": true,
                                            "description": "Zip code of this business."
                                        }
                                    }
                                },
                                "attributes": {
                                    "type": "object",
                                    "description": "Various features or facilities provided by the business.",
                                    "properties": {
                                        "business_accepts_credit_cards": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business accepts credit card payments."
                                        },
                                        "bike_parking": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business has bike parking available."
                                        },
                                        "wheelchair_accessible": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business is accessible by wheelchair."
                                        },
                                        "dogs_allowed": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether dogs are allowed on the premises."
                                        },
                                        "hot_and_new": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business is new and trending."
                                        },
                                        "liked_by_vegetarians": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business is popular among vegetarians."
                                        },
                                        "gender_neutral_restrooms": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business has gender-neutral restrooms."
                                        },
                                        "open_to_all": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business is explicitly inclusive and open to all communities."
                                        },
                                        "restaurants_counter_service": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the restaurant offers counter service."
                                        },
                                        "restaurants_good_for_groups": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the restaurant is suitable for group dining."
                                        },
                                        "request_a_quote": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business accepts quote requests."
                                        },
                                        "reservation": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business accepts reservations."
                                        },
                                        "waitlist_reservation": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business supports joining a waitlist remotely."
                                        },
                                        "business_temp_closed": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business is temporarily closed."
                                        },
                                        "menu_url": {
                                            "type": "string",
                                            "nullable": true,
                                            "description": "URL to the business's menu."
                                        },
                                        "open24_hours": {
                                            "type": "boolean",
                                            "nullable": true,
                                            "description": "Whether the business is open 24 hours a day."
                                        }
                                    }
                                },
                                "business_hours": {
                                    "type": "array",
                                    "description": "Regular business hours.\n",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "hours_type": {
                                                "type": "string",
                                                "description": "The type of hours, e.g. REGULAR."
                                            },
                                            "open": {
                                                "type": "array",
                                                "description": "List of time windows the business is open during the week.",
                                                "items": {
                                                    "type": "object",
                                                    "properties": {
                                                        "day": {
                                                            "type": "integer",
                                                            "description": "Day of the week: 0 = Monday, 6 = Sunday."
                                                        },
                                                        "start": {
                                                            "type": "string",
                                                            "description": "Opening time in 24-hour format (e.g. 0900)."
                                                        },
                                                        "end": {
                                                            "type": "string",
                                                            "description": "Closing time in 24-hour format (e.g. 2100)."
                                                        },
                                                        "is_overnight": {
                                                            "type": "boolean",
                                                            "description": "Whether the hours span midnight into the next day."
                                                        }
                                                    }
                                                }
                                            },
                                            "is_open_now": {
                                                "type": "boolean",
                                                "description": "Whether the business is currently open."
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
