{
  "openapi" : "3.0.3",
  "info" : { "title" : "Users", "version" : "1.0.0" },
  "paths" : {
    "/users/me" : {
      "get" : {
        "responses" : {
          "200" : {
            "description" : "a user; the password is sent to the API and never handed back",
            "content" : {
              "application/json" : { "schema" : { "$ref" : "#/components/schemas/User" } }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "User" : {
        "type" : "object",
        "required" : [ "id", "name", "password" ],
        "properties" : {
          "id" : { "type" : "integer" },
          "name" : { "type" : "string" },
          "password" : { "type" : "string", "writeOnly" : true }
        }
      }
    }
  }
}
