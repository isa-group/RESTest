<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.restest</groupId>
        <artifactId>restest</artifactId>
        <version>2.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>restest-oracles</artifactId>
    <name>RESTest :: Oracles</name>
    <description>Oracles and fault classification.</description>

    <dependencies>
        <dependency>
            <groupId>io.restest</groupId>
            <artifactId>restest-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
          Decides whether a reply matches the shape its specification declares. Confined to this
          module by an architecture test, as every third-party library in this project is. The
          optional regular-expression engines it offers - joni, and a GraalVM JavaScript engine -
          are deliberately not taken: they add tens of megabytes to match patterns exactly as
          ECMAScript would, and a pattern mismatch is not something this reports on. See ADR-0014.
        -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              The blocking coverage gate. It is here, on this module, rather than at the root,
              because only two modules carry a minimum: this one and the other named under
              "Quality gates" in docs/DESIGN.md.

              The figures are floors, set below what the module actually measures so that they fail
              on a real loss of testing rather than on rounding. They are never to be lowered to make
              a build pass; a rule that gets relaxed whenever it fires is not a rule.
            -->
            <!--
              Mutation testing. It deliberately corrupts this module's own code - flips a
              comparison, removes a call - and fails if the tests still pass. "Our tool finds bugs
              in your API" is a claim worth far more when the code making it has been shown to
              notice bugs in itself.

              Run on its own at any time:

                  ./mvnw org.pitest:pitest-maven:mutationCoverage -pl restest-oracles

              and, by the `mutation` profile below, as part of this module's verify, which is how
              one row of continuous integration runs it on every change. It re-runs the tests once
              per mutation, which here is about ten seconds; the threshold below is what makes the
              number mean something. Like the coverage floors, it is never to be lowered to make a
              run pass.
            -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <configuration>
                    <targetClasses>
                        <param>io.restest.oracles.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>io.restest.oracles.*</param>
                    </targetTests>
                    <timestampedReports>false</timestampedReports>
                    <mutationThreshold>85</mutationThreshold>
                    <coverageThreshold>90</coverageThreshold>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          The mutation score as a gate of this module's build: `./mvnw verify -Pmutation`, which
          continuous integration asks for on one row. A profile rather than an execution every
          build runs, so that `./mvnw verify` on a laptop stays what it is and the score is still
          paid for only where it is read.
        -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <executions>
                            <execution>
                                <id>mutation-score</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
